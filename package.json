{
  "name": "business-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --dir client dev",
    "build": "pnpm --dir client build",
    "lint": "pnpm --dir client lint",
    "format": "pnpm --dir client format",
    "typecheck": "pnpm --dir client typecheck",
    "test": "pnpm --dir client test",
    "test:browser": "pnpm --dir client test:browser",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser"
  },
  "engines": {
    "node": ">=24"
  }
}
