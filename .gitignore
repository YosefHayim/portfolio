# Frozen version snapshots (clientV1/clientV2): track source + build configs.
# Their nested .gitignore still excludes node_modules/ and dist/, and git cannot
# re-include a file whose parent dir is excluded — so these only surface real config.
!clientV1/**/*.json
!clientV2/**/*.json
!.gitignore
!.github
.dedup.json
