# Server Environment Variables
# In production these are Cloudflare Worker secrets/vars set via wrangler.jsonc or `wrangler secret put`.
# This file is only for local dev with `wrangler dev`.

# OpenAI API key for the portfolio chat assistant.
OPENAI_API_KEY=sk-your-api-key-here

# Allowed frontend origins for CORS (comma-separated). Set in wrangler.jsonc vars for prod.
FRONTEND_URL=http://localhost:3004

# Email recipient for the contact form.
CONTACT_RECIPIENT=you@example.com

# Email sender address (Cloudflare Email Routing binding provides the send capability).
EMAIL_FROM=noreply@yourdomain.com
