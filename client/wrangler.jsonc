{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-06",
  "account_id": "b0ba5fea46c96d72bfc6f12e1dafaf7b",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "joseph-tech-solutions.dev/*",
      "zone_name": "joseph-tech-solutions.dev"
    },
    {
      "pattern": "www.joseph-tech-solutions.dev/*",
      "zone_name": "joseph-tech-solutions.dev"
    },
    {
      "pattern": "yosefhayimsabag.com/*",
      "zone_name": "yosefhayimsabag.com"
    },
    {
      "pattern": "www.yosefhayimsabag.com/*",
      "zone_name": "yosefhayimsabag.com"
    },
    {
      "pattern": "yosefhayimsabag.dev/*",
      "zone_name": "yosefhayimsabag.dev"
    },
    {
      "pattern": "www.yosefhayimsabag.dev/*",
      "zone_name": "yosefhayimsabag.dev"
    }
  ]
}
