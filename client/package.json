{
  "name": "@jts/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 4173",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types deploy/workerBindings.d.ts --include-runtime false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "effect": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.58.0",
    "@axe-core/playwright": "^4.11.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0",
    "sharp": "^0.35.3"
  }
}
