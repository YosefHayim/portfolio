{
  "name": "@jts/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --local --local-upstream localhost --ip 127.0.0.1 --port 4173",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:vitals": "lhci collect && lhci assert",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types worker/cloudflareBindings.d.ts --include-runtime false"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "effect": "^3.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "^2.3.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
